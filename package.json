{
  "name": "treasured",
  "version": "0.2.0",
  "private": true,
  "description": "A wallet for the people you love. Offline-first, no accounts, no servers.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "homepage": "https://treasured.riverma.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/riverma/treasured.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check-licenses": "node scripts/check-licenses.mjs",
    "check-offline": "node scripts/check-offline.mjs",
    "audit": "scripts/audit.sh",
    "deploy": "scripts/deploy.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.5.0",
    "fake-indexeddb": "^6.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "dexie": "^4.0.0"
  }
}
